@page "/EditGame/{gameIdToEdit:int}"
@attribute [Authorize]
@using AuthTemplate.Shared.CheckDTOs
@using AuthTemplate.Shared.Games
@using AuthTemplate.Shared.EditGameContentDTOs
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS


<head>
    <title>עריכת משחק - איקס מיון</title>
</head>

<style>
    .selected-category {
        border: 2px solid blue;
        background-color: #f0f4ff;
    }
</style>

<div class="head-of-page">
    @if (String.IsNullOrWhiteSpace(displayName))
    {
        <h1>עריכת משחק</h1>
    }
    else
    {
        <h1>עריכת משחק ״@displayName״</h1>
    }
    <div class="btns-wrapper">
        @if (gameStatus.IsPublish)
        {
            <Button Variant="primary" Text="ביטול פרסום" OnClick="UnpublishGame"></Button>
        }
        else
        {
            <Tooltip Text="@(!gameStatus.CanPublish ? "המשחק לא עומד בתנאי הפרסום" : "")" MaxWidth="200">
                <Button Variant="primary" Text="פרסום משחק" OnClick="() => showPublishPopup = true"
                        Disabled="@(!gameStatus.CanPublish || contentChanged || canSave)">
                </Button>
            </Tooltip>
        }

        <Button Variant="secondery" Text="חזרה למשחקים שלי" OnClick="HandleBackNavigation"></Button>
        @* הכפתור יהיה פעיל רק במידה ומשחק חדש נשמר ויש לו מספר id בבסיס הנתונים *@

    </div>
</div>


@* ──────────────── הגדרות משחק ───────────────── *@

<AccordionSection Title="הגדרות כלליות" IsOpen="@isSettingsOpen" UnsavedChanges="@canSave">
    <HeaderButtons>
        <div class="btns-wrapper">
            <Button Type="submit"
                    Text="שמירה"
                    Variant="primary"
                    Form="settings-form"
                    Disabled="@(!canSave)"/>
            <Button Text="ביטול שינויים"
                    Variant="secondery"
                    Disabled="@(!canSave || gameToEdit.ID == 0)"
                    OnClick="CancelChanges"/>
        </div>
        
    </HeaderButtons>
    <ChildContent>
        <div class="settings-content">
            <EditForm Model="gameToEdit" OnValidSubmit="SaveGameSettings" id="settings-form">
                <DataAnnotationsValidator/>
                <div class="settings-right">
                    <div>
                        <label>
                            <span class="input-name">שם המשחק:</span>
                            <CustomInputText @bind-Value="gameToEdit.GameName"
                                             placeholder="שם משחק..."
                                             minLength="1"
                                             maxLength="30"
                                             @bind-Value:after="CheckCanSave"/>
                        </label>
                    </div>
                    <br/>
                    <div>
                        @* לא ניתן היה לשלוט בחיצים של תיבת מספר רגילה לכן בנינו כפתורים שמדמים את החיצים והסרנו את החיצים מהתיבת מספר *@
                        <label class="input-name">זמן למיון פריט בכל תור</label>
                        <div class="time-section-wrapper">
                            <div class="number-input-wrapper @(noLimit ? "disabled" : "")">
                                <div class="number-arrows">
                                    <button type="button"
                                            @onclick="() => { if (gameToEdit.RoundTime < 60) { gameToEdit.RoundTime += 5; CheckCanSave(); } }"
                                            disabled="@(gameToEdit.RoundTime >= 60 || noLimit)">
                                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M7 14L12 9L17 14" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                    <button type="button"
                                            @onclick="() => { if (gameToEdit.RoundTime > 20) { gameToEdit.RoundTime -= 5; CheckCanSave(); } }"
                                            disabled="@(gameToEdit.RoundTime <= 20 || noLimit)">
                                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M7 10L12 15L17 10" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                </div>
                                <InputNumber @bind-Value="gameToEdit.RoundTime"
                                             step="5"
                                             min="20"
                                             max="60"
                                             disabled="@noLimit"
                                             @bind-Value:after="CheckCanSave"/>
                            </div>
                            <b> או </b>
                            <label>
                                <InputCheckbox class="settings-checkbox" @bind-Value="noLimit" @bind-Value:after="OnNoLimitAndCheckSave"/>
                                ללא הגבלה
                            </label>
                        </div>

                    </div>
                    <br/>
                </div>
                
                <div class="settings-left">
                    <div>
                        <label>
                            <span class="input-name">הנחיות העורך:</span>
                            <CustomInputTextArea @bind-Value="gameToEdit.Instructions"
                                                 placeholder="כתבו הנחיה משלכם"
                                                 minLength="1"
                                                 maxLength="30"
                                                 @bind-Value:after="CheckCanSave"/>
                        </label>
                    </div>
                    <ValidationMessage For="@(() => gameToEdit.GameName)"/>
                    <ValidationMessage For="@(() => gameToEdit.Instructions)"/>
                    <p class="msg settings-msg">@msg</p>
                </div>
            </EditForm>
        </div>
        
    </ChildContent>
</AccordionSection>


@* ───────────── עריכת התוכן ───────────────── *@

<AccordionSection Title="עריכת תוכן" Disabled="@(gameToEdit.ID == 0)" UnsavedChanges="@contentChanged">

    @* ── פריטים ── *@
    <div>
        <h4>פריטים</h4>

        @if (selectedCategory == null)
        {
            <p>להוספת פריטים יש לבחור קטגוריה</p>
        }
        else
        {
            @for (int i = 0; i < selectedCategory.Items.Count; i++)
            {
                ItemToSave item = selectedCategory.Items[i]; // הפריט הנוכחי 
                string itemInputId = "item_" + i.ToString();  // שימוש באינדקס במקום ID כדי למנוע התנגשות בין פריטים ריקים
                
                
                <div class="item-container" style="border: 1px solid black; padding: 5px">
                    <label>
                        <input type="radio"
                               name="item-type-@i"
                               checked="@(!item.IsImage)"
                               disabled="@(!string.IsNullOrWhiteSpace(item.Content) && item.IsImage)"
                               @onchange="() => { item.IsImage = false; }" />
                        טקסט
                    </label>
                    <label>
                        <input type="radio"
                               name="item-type-@i"
                               checked="@item.IsImage"
                               disabled="@(!string.IsNullOrWhiteSpace(item.Content) && !item.IsImage)"
                               @onchange="() => { item.IsImage = true; }" />
                        תמונה
                    </label>

                    @if (item.IsImage)
                    {
                        @if (!string.IsNullOrWhiteSpace(item.Content)) // אם יש תוכן בעמודה
                        {
                            <img src="uploadedFiles/@item.Content" alt="פריט" style="width:80px; height:80px;" />
                            <button type="button" @onclick="() => DeleteItemImage(item)"
                                    @onclick:stopPropagation="true">מחק תמונה</button>
                        }
                        else // אם אין תוכן זה אומר שאין תמונה
                        {
                            <button type="button" @onclick="() => TriggerFileInput(itemInputId)"
                                    @onclick:stopPropagation="true">העלה תמונה</button>
                            <InputFile id="@itemInputId" OnChange="(e) => UploadItemFile(e, item)" accept="image/*"hidden />
                        }
                    }
                    else
                    {
                        <CustomInputSimple Value="@item.Content"
                                           ValueChanged="v => { item.Content = v;MarkContentChanged(); }"
                                           Placeholder="שם פריט..."
                                           MaxLength="16" />
                    }

                    <button @onclick="() => RemoveItem(item)" @onclick:stopPropagation="true"
                            disabled="@(string.IsNullOrWhiteSpace(item.Content) && selectedCategory.Items.Count <= minItems)">מחק</button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(selectedCategory.Content))
                // כפתור הוספת פריט - קיים ופעיל רק במידה ויש תוכן בקטגוריה, ניתן להוסיף פריטים ללא הגבלה
            {
                <button @onclick="AddItem">+ פריט</button>
            }
            
        }
    </div>

    @* ── קטגוריות ── *@
    <div>
        <h4>קטגוריות</h4>

        @for (int i = 0; i < categories.Count; i++)
            // שימוש בלולאת for כדי להבדיל את כפתורי הרדיו של כל אחת מהקטגוריות הריקות שאין להן עדיין id
        {
            CategoryToSave cat = categories[i]; // שימוש יותר נוח בקטגוריה הנוכחית בלולאה
            string catInputId = "cat_" + i.ToString();  // שימוש באינדקס במקום ID כדי למנוע התנגשות בין קטגוריות ריקות

            <div @key="cat" @onclick="() => SelectCategory(cat)" class="@(selectedCategory == cat ? "selected-category" : "")" style="border: 1px solid black; padding: 5px">
                @* אם הקטגוריה הנוכחית היא זו שנבחרה — מוסיפים מחלקת עיצוב מודגשת, אחרת ללא מחלקה *@

                <label>
                    <input type="radio"
                           name="cat-type-@i"
                           checked="@(!cat.IsImage)"
                           disabled="@(!string.IsNullOrWhiteSpace(cat.Content) && cat.IsImage)"
                           @onchange="() => { cat.IsImage = false;  }"
                           @onclick:stopPropagation="true"/>
                    טקסט
                </label>
                <label>
                    <input type="radio"
                           name="cat-type-@i"
                           checked="@cat.IsImage"
                           disabled="@(!string.IsNullOrWhiteSpace(cat.Content) && !cat.IsImage)"
                           @onchange="() => { cat.IsImage = true;  }"
                           @onclick:stopPropagation="true"/>
                    תמונה
                </label>

                @if (cat.IsImage)
                {
                    @if (!string.IsNullOrWhiteSpace(cat.Content)) // אם יש תמונה — הצג אותה עם אפשרות מחיקה
                    {
                        <img src="uploadedFiles/@cat.Content" alt="קטגוריה" style="width:80px; height:80px;"/>
                        <button type="button" @onclick="() => DeleteCategoryImage(cat)"
                                @onclick:stopPropagation="true">מחק תמונה</button>
                    }
                    else // אין תמונה עדיין — הצג כפתור העלאה
                    {
                        <button type="button" @onclick="() => TriggerFileInput(catInputId)"
                                @onclick:stopPropagation="true">העלה תמונה</button>
                        <InputFile id="@catInputId" OnChange="(e) => UploadCategoryFile(e, cat)" accept="image/*" hidden/>
                    }
                }
                else // טקסט — הצג תיבת קלט
                {
                    <CustomInputSimple Value="@cat.Content"
                                       ValueChanged="v => { cat.Content = v; MarkContentChanged(); }"
                                       OnFocus="() => SelectCategory(cat)"
                                       OnBlur="() => SelectCategory(cat)"
                                       Placeholder="שם קטגוריה..."
                                       MaxLength="16"/>
                }
                @* שולחת את הערך החדש לקומפוננטת אב כדי לעדכן את הטקסט החדש *@
                @* בלחיצה על תיבת הטקסט הקטגוריה תיבחר *@

                @* מחיקת קטגוריה — stopPropagation מונע בחירת הקטגוריה בעת לחיצה על מחק *@
                <button @onclick="() => RemoveCategory(cat)" @onclick:stopPropagation="true"
                        disabled="@(string.IsNullOrWhiteSpace(cat.Content) && categories.Count <= minCategories)">מחק</button>
            </div>
        }

        @* כפתור + קטגוריה — מוצג רק אם יש פחות מ-5 *@
        @if (categories.Count < 5)
        {
            <button @onclick="AddCategory">+ קטגוריה</button>
        }
    </div>

    @* ── שגיאות ולידציה ── *@
    @if (!string.IsNullOrWhiteSpace(validationMsg))
    {
        <p>@validationMsg</p>
    }

    @* ── כפתור שמור שינויים ── *@
    <br />
    <button disabled="@(!contentChanged)" @onclick="SaveContent">שמירת שינויים</button>
    <p>@contentMsg</p>

    @* ── לוח סבבים ── *@
    @if (showBoard) 
    {
        <div>
            <span>סה״כ פריטים במשחק: </span> <b>@totalItems</b>
            <span>כמות סבבים נוכחית: </span> <b>@rounds</b>
            @if (missingItems > 0)
            {
                <span>שימו לב ! כדי להשלים סבב נוסף יש להוסיף עוד </span> <b>@missingItems</b> <span>פריטים</span>
            }
        </div>
    }

</AccordionSection>

@* ── פופאפים ── *@

<PopUp IsVisible="@showPublishPopup"
       Title="פרסום משחק"
       ConfirmText="פרסום משחק"
       OnConfirm="ConfirmPublish"
       OnCancel="() => showPublishPopup = false"
       OnClose="() => showPublishPopup = false">
    <p>האם ברצונך לפרסם את המשחק "@displayName" לפי עונות השנה?</p>
    <p>קוד משחק: @gameStatus.GameCode</p>
</PopUp>

<PopUp IsVisible="@showDeleteCategoryPopup"
       Title="מחיקת קטגוריה"
       ConfirmText="מחיקה"
       OnConfirm="() => DeleteCategory(categoryToDelete)"
       OnCancel="() => showDeleteCategoryPopup = false"
       OnClose="() => showDeleteCategoryPopup = false">
    @if (deleteBreaksPublish)
    {
        <p>לקטגוריה זו קיימים
            @categoryToDeleteItemsCount
            פריטים, המחיקה תגרום לאי עמידה בתנאי הפרסום, האם למחוק בכל זאת?
        </p>
    }
    else
    {
        <span>לקטגוריה זו קיימים @categoryToDeleteItemsCount פריטים,</span><br/>
        <span>האם למחוק בכל זאת?</span>
    }
</PopUp>

<PopUp IsVisible="@showUnsavedChangesPopup"
       Title="שמירת שינויים"
       ConfirmText="שמור שינויים"
       CancelText="לא לשמור"
       OnConfirm="SaveAndNavigate"
       OnCancel="NavigateWithoutSaving"
       OnClose="() => showUnsavedChangesPopup = false">
    <span>לפני חזרה לעמוד המשחקים שלי,</span><br/>
    <span>האם לשמור את השינויים שבוצעו?</span>
</PopUp>

@code {

    // ── פרמטר ── //
    [Parameter] public int gameIdToEdit { get; set; }

    // ── פרסום המשחק ── //
    GameToTableDTO gameStatus = new GameToTableDTO();
    bool wasEverPublished = false; // כדי להראות אנימציה - האם המשחק כבר פורסם

    // ── הגדרות משחק ── //
    GameToAddDTO gameToEdit = new GameToAddDTO();
    GameToAddDTO originalGame = new GameToAddDTO();
    string displayName = ""; // שם המשחק בכותרת — מתעדכן רק אחרי שמירה
    bool noLimit = false;
    bool canSave = false;
    string msg = "";
    bool isSettingsOpen; // במידה וזה משחק חדש האקורדיון של ההגדרות יהיה כבר פתוח
    bool showPublishPopup = false; // האם להראות פופ אפ פרסום
    bool showUnsavedChangesPopup = false; // פופ-אפ שמירת שינויים (בלחיצה על ״בחזרה למשחקים שלי״)

    
    // ── עריכת תוכן ── //
    List<CategoryToSave> categories = new List<CategoryToSave>();
    CategoryToSave selectedCategory = null;
    bool contentChanged = false;
    string contentMsg = "";
    string validationMsg = "";
    // רשימות של IDs שנמחקו — ישלחו לשרת בעת שמירה
    List<int> deletedCategoryIds = new List<int>();
    List<int> deletedItemIds = new List<int>();
    
    // ── ספירת סבבים ── //
    int totalItems = 0; // ספירת פריטים
    int rounds = 0; // ספירת סבבים
    int missingItems = 0; // כמה פריטים צריך להוסיף עד להשלמת סבב נוסף במשחק
    string boardMsg = "";
    bool showBoard = false; // נרצה שיראו את הלוח רק במידה ויש לפחות קטגוריה אחת עם תוכן
    
    // ── מחיקת קטגוריה ── //
    bool showDeleteCategoryPopup = false;
    CategoryToSave categoryToDelete = null;
    string categoryToDeleteItemsCount = ""; // בשביל הפופ-אפ
    bool deleteBreaksPublish = false;


    // ── העלאת תמונה ── //
    long maxFileSize = 4194304;

    
    // ── תנאים למינימום פיריטים וקטגוריות ── //
    int minCategories = 3; // מינימום קטגוריות
    int minItems = 6; // מינימום פריטים לקטגוריה

    

    // ── טעינה ראשונית ── //
    protected override async Task OnParametersSetAsync()
        // כאשר הוגדר פרמטר וקיבלנו מספר דרך הנתיב
    {
       
        if (gameIdToEdit == 0) // אם זה משחק חדש
        {
            gameToEdit = new GameToAddDTO(); // איפוס משתנה
            originalGame = new GameToAddDTO(); // איפוס המשתנה
            isSettingsOpen = true; // אם זה משחק חדש האקורדיון צריך להיות פתוח בהגדרות המשחק
        }
        else if (gameIdToEdit > 0) // אם זה משחק קיים
        {
            isSettingsOpen = false; // סגור במידה וזה משחק קיים - המשתמש יבחר מה לפתוח קודם
            await LoadGameSettings(); // טעינת הגדרות
            await LoadPublishStatus(); // טעינת סטטוס פרסום
            await LoadGameContent(); // טעינת תוכן (קטגוריות ופריטים)
        }
    }

    async Task LoadGameSettings()
// טעינת הגדרות המשחק מהשרת
    {
        var gameRes = await Http.GetAsync($"api/EditGame/GetGame/{gameIdToEdit}");
        if (gameRes.IsSuccessStatusCode)
        {
            gameToEdit = await gameRes.Content.ReadFromJsonAsync<GameToAddDTO>();

            if (gameToEdit.RoundTime == 0)
                noLimit = true;
            // אם הנתון של ללא הגבלה מסומן אז גם הצ׳ק בוקס צריך להופיע מסומן

            originalGame = new GameToAddDTO
            {
                GameName = gameToEdit.GameName,
                RoundTime = gameToEdit.RoundTime,
                Instructions = gameToEdit.Instructions
            };
            displayName = gameToEdit.GameName;
        }
    }


    async Task LoadPublishStatus()
    {
        var publishRes = await Http.GetAsync($"api/EditGame/GetPublishStatus/{gameIdToEdit}");
        if (publishRes.IsSuccessStatusCode)
        {
            gameStatus = await publishRes.Content.ReadFromJsonAsync<GameToTableDTO>(); // שמירת מצב הפרסום הנוכחי אחרי לחיצה על כפתור ״שמירת שינויים״
            if (gameStatus.IsPublish)
                wasEverPublished = true; // בשביל האנימציה 
        }
    }

    async Task UpdateCanPublishStatus()
    {
        await Http.PostAsync($"api/Games/CheckCanPublish/{gameToEdit.ID}", null);
        await LoadPublishStatus();
    }

    async Task LoadGameContent()
    {
        categories = new List<CategoryToSave>();
        selectedCategory = null;
        // מאפס את הרשימה ואת הקטגוריה הבחורה כל טעינה מחדש ומונע כפילויות
        var res = await Http.GetAsync($"api/EditGame/GetGameContent/{gameIdToEdit}");
        if (res.IsSuccessStatusCode)
        {
            var fullGame = await res.Content.ReadFromJsonAsync<FullGameToSave>();
            if (fullGame != null)
                categories = fullGame.Categories; // כל המידע נמצא פה ברשימת הקטגוריות - כל קטגוריה מכילה רשימת פריטים
            else
                categories = new List<CategoryToSave>(); // אם אין תוכן כלל אז תיצור רשימה ריקה - ישמש לבדיקה לפלייסהולדרים
        }

        // השלמה למינימום 3 קטגוריות עם פלייסהולדרים ריקים
        while (categories.Count < minCategories)
        {
            categories.Add(new CategoryToSave { Items = new List<ItemToSave>() });
            // כל עוד יש לנו פחות מ3 קטגוריות תשלים מידע ריק כדי להראות פלייסהולדרים
        }

        // השלמת פריטים למינימום 6 לכל קטגוריה שיש לה תוכן
        foreach (var cat in categories)
        {
            EnsureMinItems(cat);
        }
        CalcStats(); 
    }

    async Task ConfirmPublish()
// אישור פרסום המשחק לאחר לחיצה על כפתור האישור בפופ אפ     
    {
        PublishGame publishData = new PublishGame { ID = gameToEdit.ID, IsPublish = true };
        // יוצרים משתנה חדש עם מזהה המשחק ו-IsPublish=true כדי לפרסם

        var res = await Http.PostAsJsonAsync("api/Games/publishGame", publishData);
        if (res.IsSuccessStatusCode)
        {
            showPublishPopup = false;
            // סגירת הפופ אפ
            gameStatus.IsPublish = true;
            // עדכון המשתנה בעמוד כדי שהכפתור יתחלף ויזואלית

            if (!wasEverPublished)
            {
                wasEverPublished = true;
                // סימון שהמשחק פורסם לראשונה — כדי שהאנימציה תופיע רק הפעם
                // כאן בהמשך נוסיף את האנימציה
            }
        }
    }

    async Task UnpublishGame()
// ביטול פרסום המשחק    
    {
        PublishGame publishData = new PublishGame { ID = gameToEdit.ID, IsPublish = false };
        //  משתנה מסוג PublishGame עם מזהה המשחק ו-IsPublish=false כדי לבטל פרסום

        var res = await Http.PostAsJsonAsync("api/Games/publishGame", publishData);
        // שולחים את המשתנה החדש לשרת כדי לבטל פרסום

        if (res.IsSuccessStatusCode)
        {
            gameStatus.IsPublish = false;
            // אם השרת אישר — מעדכנים את המשתנה בעמוד כדי שנראה גם ויזואלית את השינוי
        }
    }

    void EnsureMinItems(CategoryToSave cat)
        // השלמת רשימת הפריטים של קטגוריה למינימום 6 — רק אם יש לה תוכן
    {
        if (cat.Items == null)
            cat.Items = new List<ItemToSave>();

        if (!string.IsNullOrWhiteSpace(cat.Content)) // רק אם לקטגוריה יש תוכן (תמונה או טקסט)
        {
            while (cat.Items.Count < minItems) // כל עוד רשימת הפריטים מונה פחות מכמות הפריטים המינימלית (6 פריטים)
            {
                cat.Items.Add(new ItemToSave { CategoryID = cat.ID }); // תשלים מידע ריק בשביל הפלייסהולדרים
            }
        }
    }

    void SelectCategory(CategoryToSave cat)
        // בחירת קטגוריה — גם משלימה את הפריטים שלה למינימום
    {
        selectedCategory = cat;
        EnsureMinItems(cat);
    }

    // ── הוספת קטגוריה / פריט ── //

    void AddCategory()
        // הוספת קטגוריה ריקה חדשה (עד מקסימום 5) בלחיצה על כפתור +
    {
        if (categories.Count < 5)
        {
            categories.Add(new CategoryToSave { Items = new List<ItemToSave>() });
        }
    }

    void AddItem()
        // הוספת פריט ריק לקטגוריה הנבחרת
    {
        if (selectedCategory != null)
        {
            selectedCategory.Items.Add(new ItemToSave { CategoryID = selectedCategory.ID });
        }
    }

    // ── מחיקת קטגוריה / פריט ── //

    void RemoveCategory(CategoryToSave cat)
    {
        bool hasItems = false; // כדי לבדוק אם יש בקטגוריה פריטים או לא (משפיע על התצוגה בפופ אפ ועל התנהגות המחיקה)
        int itemsCount = 0; // בשביל התצוגה בפופ אפ 

        if (cat.Items != null) // לסכום את מספר הפריטים של הקטגוריה הנוכחית שנרצה למחוק
        {
            foreach (ItemToSave item in cat.Items)
            {
                if (!string.IsNullOrWhiteSpace(item.Content))
                {
                    hasItems = true;
                    itemsCount++;
                }
            }
        }

        // בדיקה כמה קטגוריות עומדות בתנאי הפרסום כרגע
        int validCategoriesCount = 0;
        foreach (CategoryToSave c in categories)
        {
            if (!string.IsNullOrWhiteSpace(c.Content)) // אם יש תוכן לקטגוריה
            {
                int itemsWithContent = 0; // יסכום את הקטגוריות
                foreach (ItemToSave item in c.Items) // מעבר על הפריטים של אותה קטגוריה
                {
                    if (!string.IsNullOrWhiteSpace(item.Content)) // אם לפריט הזה יש תוכן
                        itemsWithContent++; // תסכום גם אותו
                }

                if (itemsWithContent >= minItems) // אם הקטגוריה עומדת בתנאי הפרסום - מינימום פריטים לכל קטגוריה
                    validCategoriesCount++; // תסכום לקטגוריות שעומדות בתנאי פרסום
            }
        }

        deleteBreaksPublish = gameStatus.CanPublish && validCategoriesCount <= minCategories;
        // אם המשחק עומד בתנאים כרגע ויש בדיוק מינימום קטגוריות תקינות — המחיקה תשבור את התנאים

        if (hasItems || deleteBreaksPublish)
            // פתיחת פופ אפ אם יש פריטים או שהמחיקה תשבור תנאי פרסום
        {
            categoryToDelete = cat;
            categoryToDeleteItemsCount = itemsCount.ToString();
            showDeleteCategoryPopup = true;
        }
        else
        {
            DeleteCategory(cat);
            // מחיקה ישירה ללא וידוא
        }
    }



    void DeleteCategory(CategoryToSave cat)
// מחיקת הקטגוריה בפועל    
    {
        if (cat.ID > 0)
            deletedCategoryIds.Add(cat.ID); // כדי לעדכן בכפתור שמירה

        categories.Remove(cat); // עדכון ויזואלי

        if (selectedCategory == cat)
            selectedCategory = null; // איפוס הקטגוריה שנבחרה

        while (categories.Count < minCategories) // אם מספר הקטגוריות עכשיו קטן מהמינימום צריך להוסיף פלייסהולדר
        {
            categories.Add(new CategoryToSave { Items = new List<ItemToSave>() });
        }

        MarkContentChanged(); // יש שינוי בעריכת התוכן
        showDeleteCategoryPopup = false; // סגירת הפופ-אפ
        categoryToDelete = null; // איפוס קטגוריה למחיקה
    }

    void RemoveItem(ItemToSave item)
        // מחיקת פריט — אם היה שמור בבסיס הנתונים נוסיף ל-DeletedItemIds
    {
        if (item.ID > 0)
            deletedItemIds.Add(item.ID);

        selectedCategory.Items.Remove(item);

        // שמירה על מינימום 6 פריטים ויזואלית אם לקטגוריה יש תוכן
        EnsureMinItems(selectedCategory);

        MarkContentChanged();
    }

    // ── ולידציה לפני שמירה ── //

    bool ValidateContent()
    {
        foreach (var cat in categories)
        {
            if (cat.ID > 0 && string.IsNullOrWhiteSpace(cat.Content) && !cat.IsImage)
            {
                validationMsg = "לא ניתן לשמור קטגוריה ריקה — מחק אותה או הוסף תוכן";
                return false;
            }

            if (cat.Items != null)
            {
                foreach (var item in cat.Items)
                {
                    if (item.ID > 0 && string.IsNullOrWhiteSpace(item.Content) && !item.IsImage)
                    {
                        validationMsg = "לא ניתן לשמור פריט ריק — מחק אותו או הוסף תוכן";
                        return false;
                    }
                }
            }
        }

        validationMsg = "";
        return true;
    }

    // ── הגדרות משחק: שמירה ── //
    void CheckCanSave()
    {
        msg = "";
        // אם משהו השתנה באחד מהתכנים מהגרסה המקורית
        canSave = (gameToEdit.GameName != originalGame.GameName
                   || gameToEdit.RoundTime != originalGame.RoundTime
                   || gameToEdit.Instructions != originalGame.Instructions)
                  && !string.IsNullOrWhiteSpace(gameToEdit.GameName)
                  && !string.IsNullOrWhiteSpace(gameToEdit.Instructions);
    }

    void OnNoLimitChanged()
        // בשינוי של הצ׳קבוקס זמן לכל תור
    {
        if (noLimit)
        {
            gameToEdit.RoundTime = 0;
        }
        else
        {
            gameToEdit.RoundTime = 30; // ברירת מחדל כשמבטלים
        }
    }

    void OnNoLimitAndCheckSave()
    {
        OnNoLimitChanged();
        CheckCanSave();
    }

    async Task SaveGameSettings()
        // בלחיצה על ״שמירה״
    {
        gameToEdit.GameName = gameToEdit.GameName.Trim();
        gameToEdit.Instructions = gameToEdit.Instructions.Trim();
        // חקירה עצמית: הפונקציה Trim מוחקת רווחים מיותרים בהתחלה ובסוף לפני השליחה לשרת

        if (gameToEdit.ID == 0)
            // אם זה משחק חדש תקרא לפונקציה בשרת שיוצרת משחק חדש
        {
            var newGameRes = await Http.PostAsJsonAsync("api/Games/addGame", gameToEdit);
            if (newGameRes.IsSuccessStatusCode)
            {
                var newGame = await newGameRes.Content.ReadFromJsonAsync<GameToTableDTO>();
                gameToEdit.ID = newGame.ID;
                displayName = gameToEdit.GameName;
                msg = "המשחק נוצר בהצלחה";
                msg = "";
                canSave = false;
                originalGame = new GameToAddDTO // שמירת גרסה לתוך המשתנה
                {
                    GameName = gameToEdit.GameName,
                    RoundTime = gameToEdit.RoundTime,
                    Instructions = gameToEdit.Instructions
                };
                await LoadGameContent(); // עכשיו יש ID אז אפשר לטעון פלייסהולדרים
            }
        }
        else
            // אם זה משחק קיים תעדכן את הפרטים בהתאם
        {
            var editRes = await Http.PostAsJsonAsync("api/EditGame/UpdateGame", gameToEdit);
            if (editRes.IsSuccessStatusCode)
            {
                displayName = gameToEdit.GameName; // עדכון הכותרת רק אחרי שמירה
                msg = "המשחק עודכן בהצלחה";
                canSave = false;
                originalGame = new GameToAddDTO
                {
                    GameName = gameToEdit.GameName,
                    RoundTime = gameToEdit.RoundTime,
                    Instructions = gameToEdit.Instructions
                };
            }
        }
    }

    void CancelChanges()
        // בלחיצה על ביטול שינויים נרצה להחזיר את הפרטים של המשחק האחרון שנשמר
    {
        gameToEdit = new GameToAddDTO
        {
            ID = gameToEdit.ID,
            GameName = originalGame.GameName,
            RoundTime = originalGame.RoundTime,
            Instructions = originalGame.Instructions
        };
        if (originalGame.RoundTime == 0)
            noLimit = true;
        else
            noLimit = false;
        canSave = false;
        msg = "";
    }
    
    void MarkContentChanged()
    // המטרה: להגיד שיש שינוי בעריכת התוכן וגם לנקות את התיבה
    {
        contentChanged = true;;
        contentMsg = "";
    }
    
    void CalcStats()
    {
        // איפוס משתנים
        totalItems = 0;
        showBoard = false;

        foreach (CategoryToSave cat in categories)
        {
            if (!string.IsNullOrWhiteSpace(cat.Content)) // בדיקה שיש תוכן בלפחות קטגוריה אחת
                showBoard = true;

            if (cat.Items != null) // ספרית כל הפריטים
            {
                foreach (ItemToSave item in cat.Items)
                {
                    if (!string.IsNullOrWhiteSpace(item.Content))
                        totalItems++;
                }
            }
        }

        rounds = totalItems / 9; // כל סבב במשחק מורכב מכמות הפריטים בסה״כ חלקי 9 ועיגול כלפי מטה
        // חקירה עצמית: חלוקה של int בint תחזיר תמיד תוצאה מעוגלת כלפי מטה

        if (totalItems % 9 != 0)
            missingItems = 9 - (totalItems % 9);
        else
            missingItems = 0;
    }

    // ── שמירת תוכן ── //
    async Task SaveContent()
    // מטרתה של הפונקציה היא:
    // 1. לבדוק שהתוכן שהוזן נכון 
    // 2. לשלוח את המופע - משחק שלם שמכיל את כל השינויים שהמשתמש עשה
    //3. טוען את התוכן חזרה מהשרת כדי לעדכן קטגוריות / פריטים שהתווספו
    // 4. בדיקת מצב הפרסום
    {
        // ולידציה לפני שליחה לשרת
        if (!ValidateContent())
            return;

        foreach (var cat in categories)
            // כדי למנוע תווים מיותרים כמו רווחים בסוף או בהתחלה של התוכן - נעשה זאת לפני השליחה של הנתונים לשרת
        {
            if (!string.IsNullOrWhiteSpace(cat.Content))
                cat.Content = cat.Content.Trim();
            foreach (var item in cat.Items ?? new List<ItemToSave>())
            {
                if (!string.IsNullOrWhiteSpace(item.Content))
                    item.Content = item.Content.Trim();
            }
        }

        
        FullGameToSave fullGame = new FullGameToSave
        {
            Categories = categories,
            DeletedCategoryIds = deletedCategoryIds,
            DeletedItemIds = deletedItemIds
        };

        var res = await Http.PostAsJsonAsync($"api/EditGame/SaveContent/{gameToEdit.ID}", fullGame);
        if (res.IsSuccessStatusCode)
        {
            contentMsg = "השינויים נשמרו בהצלחה";
            contentChanged = false;
            // איפוס רשימות המחיקה לאחר שמירה מוצלחת
            deletedCategoryIds = new List<int>();
            deletedItemIds = new List<int>();
            // טעינה מחדש מהשרת כדי לקבל IDים מעודכנים
            await LoadGameContent();
            await UpdateCanPublishStatus();; // אולי מצב הפרסום השתנה - צריך לבדוק
            CalcStats(); // חישוב מספר הפריטים לתצוגה של הלוח

        }
        else
        {
            contentMsg = "שגיאה בשמירה";
        }
    }
    
    void HandleBackNavigation() // ההחלטה אם לפתוח את הפופ-אפ ״בחזרה למשחקים שלי״ או פשוט לחזור אחורה
    {
        if (canSave || contentChanged )  // אם יש שינויים שלא נשמרו
            showUnsavedChangesPopup = true; // תפתח את הפופ-אפ
        else
            Nav.NavigateTo("/GamesList"); // אם הכל שמור פשוט תחזור אחורה
    }

    async Task SaveAndNavigate() // לחיצה על ״שמירת שינויים״ בפופ-אפ ״בחזרה למשחקים שלי״
    {
        if (contentChanged)
            await SaveContent();
        if (canSave)
            await SaveGameSettings();
        showUnsavedChangesPopup = false;
        Nav.NavigateTo("/GamesList");
    }

    void NavigateWithoutSaving() // לחיצה על כפתור ״לא לשמור״ בפופ-אפ ״בחזרה למשחקים שלי״
    {
        showUnsavedChangesPopup = false;
        Nav.NavigateTo("/GamesList");
    }

    async Task TriggerFileInput(string inputId)
    {
        contentMsg = ""; // לנקות את התיבת טקסט 
        await JS.InvokeVoidAsync("triggerFileClick", inputId);
    }

    async Task UploadItemFile(InputFileChangeEventArgs e, ItemToSave item)
    {
        var file = e.GetMultipleFiles().FirstOrDefault();
        if (file == null) return;
        if (file.Size > maxFileSize) // במידה וגודל התמונה לא מתאים - ניתן חיווי למשתמש
        {
            contentMsg = "התמונה גדולה מדי — מקסימום 4MB";
        }

        var buffer = new byte[file.Size];
        await file.OpenReadStream(maxFileSize).ReadAsync(buffer);
        var imageBase64 = Convert.ToBase64String(buffer);

        var saveRes = await Http.PostAsJsonAsync("api/Media/upload", imageBase64);
        if (saveRes.IsSuccessStatusCode)
        {
            string newFileName = await saveRes.Content.ReadAsStringAsync();
            item.Content = newFileName;
            item.IsImage = true;
            // שמירה מיידית של שם התמונה ב-DB
            if (item.ID > 0)
                await Http.PostAsJsonAsync($"api/EditGame/UpdateItemImage/{item.ID}", newFileName);
            MarkContentChanged();
        }
    }

    async Task UploadCategoryFile(InputFileChangeEventArgs e, CategoryToSave cat)
    {
        var file = e.GetMultipleFiles().FirstOrDefault();
        if (file == null) return;
        if (file.Size > maxFileSize)
        {
            contentMsg = "התמונה גדולה מדי — מקסימום 4MB";
        }

        var buffer = new byte[file.Size];
        await file.OpenReadStream(maxFileSize).ReadAsync(buffer);
        var imageBase64 = Convert.ToBase64String(buffer);

        var saveRes = await Http.PostAsJsonAsync("api/Media/upload", imageBase64);
        if (saveRes.IsSuccessStatusCode)
        {
            string newFileName = await saveRes.Content.ReadAsStringAsync();
            cat.Content = newFileName;
            cat.IsImage = true;
            // שמירה מיידית של שם התמונה ב-DB
            if (cat.ID > 0)
                await Http.PostAsJsonAsync($"api/EditGame/UpdateCategoryImage/{cat.ID}", newFileName);
            MarkContentChanged();
        }
    }

    async Task DeleteItemImage(ItemToSave item)
    {
        if (string.IsNullOrWhiteSpace(item.Content)) return;

        var imagesToDelete = new List<string> { item.Content };
        var deleteRes = await Http.PostAsJsonAsync("api/Media/deleteImages", imagesToDelete);

        if (deleteRes.IsSuccessStatusCode)
        {
            item.Content = "";
            MarkContentChanged();
        }
    }

    async Task DeleteCategoryImage(CategoryToSave cat)
    {
        if (string.IsNullOrWhiteSpace(cat.Content)) return;

        var imagesToDelete = new List<string> { cat.Content };
        var deleteRes = await Http.PostAsJsonAsync("api/Media/deleteImages", imagesToDelete);

        if (deleteRes.IsSuccessStatusCode)
        {
            cat.Content = "";
            MarkContentChanged();
        }
    }

